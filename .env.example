# ==============================================================================
# Sovereign Security Stack Environment Configuration
# ==============================================================================

# Core & Bridge Security Contract
JWT_SECRET=bhiv_sovereign_2026_key_!!
JWT_ISSUER=sovereign-core
JWT_AUDIENCE=insight-bridge

# Service Authentication Secrets
CORE_CLIENT_SECRET=bridge_secret_123
INGESTION_TOKEN=flow_secret_789

# VM Host Exposed Ports (ports 8000, 8001, 8002 already used on VM)
# Mapped in Docker Compose:
# Host 8029 -> Container 8000 (InsightBridge)
# Host 8030 -> Container 8001 (InsightCore)
# Host 8031 -> Container 8002 (InsightFlow)
BRIDGE_PORT=8029
CORE_PORT=8030
FLOW_PORT=8031

# Service Internal URLs (for inter-container Docker Compose communication)
FLOW_URL=http://insight-flow:8002/telemetry/ingest
CORE_URL=http://insight-core:8001
BRIDGE_URL=http://insight-bridge:8000

# Artifact Bucket Storage
BUCKET_DIR=/app/bucket

